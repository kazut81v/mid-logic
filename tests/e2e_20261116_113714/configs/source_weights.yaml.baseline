sources:
  - id: gov_official
    type: manual
    reliability_category: critical
    base_weight: 1.0
    refresh_interval_min: 1440
    failure_threshold: 3
    health_check_endpoint: "manual_check"
    selector_config: ["official_bulletin", "press_release"]
  - id: tech_journal_a
    type: rss
    reliability_category: high
    base_weight: 0.8
    refresh_interval_min: 60
    failure_threshold: 5
    health_check_endpoint: "rss_feed"
    selector_config: ["tech_trends"]

# Health Check Metadata (Managed via engine logic)
health_metrics:
  gov_official: { last_success: "2026-11-15", consecutive_failures: 0 }
  tech_journal_a: { last_success: "2026-11-15", consecutive_failures: 0 }
